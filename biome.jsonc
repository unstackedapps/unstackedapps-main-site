{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": ["!dist", "!public", "!node_modules"]
  },
  "linter": {
    "rules": {
      "style": {
        "useFilenamingConvention": "off"
      },
      "performance": {
        "noJsxPropsBind": "off"
      },
      "suspicious": {
        "noReactForwardRef": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/components/ui/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noNoninteractiveElementInteractions": "off",
            "noStaticElementInteractions": "off",
            "useKeyWithClickEvents": "off"
          },
          "performance": {
            "noNamespaceImport": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noLeakedRender": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/HeroMacEditorDemo.tsx",
        "src/components/LogoCarousel.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      "includes": ["src/pages/SPAShowcase.tsx", "src/pages/ResumeDemo.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noLabelWithoutControl": "off",
            "noNoninteractiveElementInteractions": "off",
            "noStaticElementInteractions": "off",
            "useButtonType": "off",
            "useKeyWithClickEvents": "off",
            "useValidAnchor": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "correctness": {
            "useImageSize": "off"
          },
          "style": {
            "noIncrementDecrement": "off"
          },
          "suspicious": {
            "noLeakedRender": "off",
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      "includes": ["src/pages/ContactForm.tsx"],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "noUnknownAtRules": "off"
          }
        }
      }
    }
  ]
}
